# Server Port (defaults to 3000; Cloud Run / Render / Railway inject PORT automatically)
PORT=3000

# APP_URL: The live URL where your application is hosted
APP_URL="https://your-app-domain.com"

# GEMINI_API_KEY: Server-side Gemini API key (never expose with VITE_ prefix)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key (server-side only).
# Recommended for production hosting (Vercel/Netlify/Render) for higher quota & reliability.
# Keep restricted by API (YouTube Data API v3) in Google Cloud Console.
YOUTUBE_API_KEY=""

# GOOGLE_SEARCH_API_KEY & GOOGLE_SEARCH_CX: Optional Google Custom Search JSON API credentials (server-side only).
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_CX=""
